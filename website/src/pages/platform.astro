---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';

const DEMO_URL = 'https://cal.com/coracle.social';
const PRICING_URL = '/pricing';
const SELF_HOST_URL = '/articles/self-hosting-a-space';

const included = [
  {
    title: 'Your own app',
    body: 'Flotilla under your name on iOS, Android and the web, with your icon, your colors and your domain. Members never see our brand.',
    icon: 'ph:device-mobile',
  },
  {
    title: 'Custom development',
    body: "Features built for how your organization works: chapter structures, member tiers, onboarding, reporting, whatever the off-the-shelf app doesn't do.",
    icon: 'ph:code',
  },
  {
    title: 'Integrations',
    body: 'Connect your member database, single sign-on, payments and the rest of your stack. Full API access, with automations through n8n.',
    icon: 'ph:plugs-connected',
  },
  {
    title: 'A say in the roadmap',
    body: 'Your priorities shape what we build next. Platform customers get a seat at the table when we decide what ships.',
    icon: 'ph:map-trifold',
  },
  {
    title: 'Dedicated support',
    body: 'A direct line to the people who build Flotilla. We run your hosting, upgrades and backups.',
    icon: 'ph:headset',
  },
  {
    title: 'Migration',
    body: 'We move your members, history and directory from your current platform, so no one starts from zero.',
    icon: 'ph:arrows-left-right',
  },
] as const;

const audiences = [
  { label: 'Peer networks & mastermind groups', icon: 'ph:users-three' },
  { label: 'Professional associations & trade groups', icon: 'ph:buildings' },
  { label: 'Membership organizations with a brand to protect', icon: 'ph:seal-check' },
  { label: 'Teams that would rather build on a platform than around one', icon: 'ph:wrench' },
] as const;

const comparison = [
  { row: 'Price', grow: 'from $5/mo', branded: 'from $300/mo', platform: 'from $6,000/mo' },
  { row: 'App', grow: 'The Flotilla app', branded: 'Your own app', platform: 'Your own app' },
  { row: 'Hosting', grow: 'Shared', branded: 'Shared', platform: 'Dedicated' },
  { row: 'Migration', grow: '—', branded: 'Included', platform: 'Included' },
  { row: 'Custom development', grow: '—', branded: '—', platform: 'Included' },
  { row: 'Integrations', grow: 'Public API', branded: 'Public API', platform: 'Built with you' },
  { row: 'Support', grow: 'Community', branded: 'Priority', platform: 'Dedicated' },
] as const;

const faqs = [
  {
    q: 'How is Platform different from the Branded plan?',
    a: 'Branded puts Flotilla under your name in the app stores. Platform adds custom development, integrations, dedicated hosting and support, and a say in the roadmap.',
  },
  {
    q: 'Who owns the app and the data?',
    a: "You do. The app is published under your organization's name, your members' identities and history live on an open protocol, and everything is exportable.",
  },
  {
    q: 'What if we want to leave?',
    a: 'Flotilla is open source and self-hostable, so you can take the app and the data in-house, or to another host, whenever you like. Your members keep their accounts and history.',
  },
  {
    q: 'What does the first call cover?',
    a: 'What your members do today, what you would change, and whether Platform is the right fit. We scope timeline and price together from there.',
  },
] as const;
---

<BaseLayout
  title="Platform"
  description="Flotilla Platform: your own community app and infrastructure, built around your organization. Custom development, integrations, dedicated support and a say in the roadmap, from $6,000/mo."
>
  <!-- Hero -->
  <section class="relative py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary-soft">Platform</p>
        <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl md:text-6xl">
          A community platform built around your organization
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base text-text-muted sm:text-lg">
          For membership networks, associations and institutions that need their own app, their
          own data and a team behind both.
        </p>
        <p class="mt-6 flex items-baseline justify-center gap-1.5">
          <span class="text-sm text-text-dim">from</span>
          <span class="text-4xl font-extrabold">$6,000</span>
          <span class="text-sm text-text-dim">/mo</span>
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href={DEMO_URL}>Book a call</Button>
          <Button href={PRICING_URL} variant="secondary">See all plans</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="relative border-y border-border-soft bg-surface-2/30 py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="text-center">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary-soft">What's included</p>
        <h2 class="mt-3 text-4xl font-extrabold sm:text-5xl">
          Your app. Our team.
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base text-text-muted sm:text-lg">
          Everything in the Branded plan, plus the engineering and attention to make it fit.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {included.map((card) => (
          <div class="rounded-2xl border border-border-soft bg-surface/60 p-7 backdrop-blur-sm">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/15 text-primary-soft">
              <Icon name={card.icon} class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-6 text-2xl font-extrabold">{card.title}</h3>
            <p class="mt-3 text-text-muted">{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why it costs what it does -->
  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary-soft">The price</p>
          <h2 class="mt-3 text-4xl font-extrabold sm:text-5xl">
            What the fee buys
          </h2>
          <p class="mt-6 max-w-xl text-base text-text-muted sm:text-lg">
            Flotilla is open source, and hosting a community costs a few dollars a month. You can
            see that on our <a href={PRICING_URL} class="text-primary-soft hover:underline">pricing page</a>.
            The Platform fee buys engineering, integration work and the attention of the people
            who make the software.
          </p>
        </div>
        <ul class="space-y-4">
          {[
            'No per-seat fees, however many members you have',
            'No transaction fees on anything your members pay you',
            'Your data is yours, exportable at any time',
            'Open source and self-hostable',
          ].map((item) => (
            <li class="flex items-start gap-3 rounded-2xl border border-border-soft bg-surface/50 p-5">
              <Icon name="ph:check-circle" class="mt-0.5 h-5 w-5 flex-none text-primary-soft" aria-hidden="true" />
              <span class="font-bold">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="relative border-y border-border-soft bg-surface-2/30 py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="text-center">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary-soft">Which one?</p>
        <h2 class="mt-3 text-4xl font-extrabold sm:text-5xl">
          Grow, Branded or Platform
        </h2>
      </div>

      <div class="mt-12 overflow-x-auto rounded-2xl border border-border-soft bg-surface/50">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead>
            <tr class="border-b border-border-soft text-xs font-bold uppercase tracking-[0.16em] text-text-dim">
              <th class="px-6 py-4"></th>
              <th class="px-6 py-4">Grow</th>
              <th class="px-6 py-4">Branded</th>
              <th class="px-6 py-4 text-primary-soft">Platform</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((r) => (
              <tr class="border-b border-border-soft last:border-b-0">
                <th scope="row" class="px-6 py-4 font-bold">{r.row}</th>
                <td class="px-6 py-4 text-text-muted">{r.grow}</td>
                <td class="px-6 py-4 text-text-muted">{r.branded}</td>
                <td class="px-6 py-4 font-bold">{r.platform}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="text-center">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary-soft">Who it's for</p>
        <h2 class="mt-3 text-4xl font-extrabold sm:text-5xl">
          Networks, associations and institutions
        </h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((a) => (
          <div class="flex flex-col items-center gap-4 rounded-2xl border border-border-soft bg-surface/50 p-7 text-center">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary-soft ring-1 ring-inset ring-primary/25">
              <Icon name={a.icon} class="h-7 w-7" aria-hidden="true" />
            </span>
            <span class="font-bold">{a.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative border-y border-border-soft bg-surface-2/30 py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <div class="text-center">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary-soft">Questions</p>
        <h2 class="mt-3 text-4xl font-extrabold sm:text-5xl">Before you book</h2>
      </div>
      <dl class="mt-12 space-y-8">
        {faqs.map((f) => (
          <div>
            <dt class="text-lg font-extrabold">{f.q}</dt>
            <dd class="mt-2 text-text-muted">{f.a}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-10 text-center text-sm text-text-dim">
        Want to run it yourself instead? Flotilla is
        <a href={SELF_HOST_URL} class="text-primary-soft hover:underline">self-hostable</a> at no cost.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-5 text-center md:px-8">
      <h2 class="text-4xl font-extrabold sm:text-5xl md:text-6xl">
        Let's talk about your community
      </h2>
      <p class="mx-auto mt-6 max-w-lg text-base text-text-muted sm:text-lg">
        A conversation about how your members connect today and what you'd change.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href={DEMO_URL}>Book a call</Button>
      </div>
    </div>
  </section>
</BaseLayout>
