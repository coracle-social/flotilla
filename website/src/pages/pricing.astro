---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { CREATE_SPACE } from '../lib/analytics';

const CREATE_URL = 'https://app.flotilla.social/spaces/create';
const DEMO_URL = 'https://cal.com/coracle.social';
const SELF_HOST_URL = '/articles/self-hosting-a-space';

// Platform is a separate product, so it sits below the grid.
const tiers = [
  {
    name: 'Free',
    priceLabel: '',
    price: '$0',
    priceSuffix: '',
    tagline: 'Everything you need to start and run a community.',
    features: [
      'Chat, threads & rooms',
      'Events & polls',
      'Moderation, roles & access controls',
      'Member directory & activity feed',
    ],
    cta: { label: 'Start free', href: CREATE_URL, variant: 'secondary', class: `w-full ${CREATE_SPACE}` },
    featured: false,
  },
  {
    name: 'Grow',
    priceLabel: 'from',
    price: '$5',
    priceSuffix: '/mo',
    tagline: "For communities that are taking off.",
    features: [
      'Basic, $5/mo: up to 100 members',
      'Growth, $25/mo: unlimited members',
      'Voice & video calls',
      'Media & file storage',
      'Your own custom domain',
    ],
    cta: { label: 'Start a community', href: CREATE_URL, variant: 'primary', class: `w-full ${CREATE_SPACE}` },
    featured: true,
  },
  {
    name: 'Branded',
    priceLabel: 'from',
    price: '$300',
    priceSuffix: '/mo',
    tagline: 'For community organizers with a curated brand.',
    features: [
      'Everything in Grow',
      'Your own iOS & Android app',
      'Your name, icon & colors',
      'Hands-on help migrating your community',
      'Priority support',
    ],
    cta: { label: 'Talk to us', href: DEMO_URL, variant: 'secondary', class: 'w-full' },
    featured: false,
  },
] as const;

const platformFeatures = [
  'Everything in Branded',
  'Custom development for how your organization works',
  'Integrations with your CRM, SSO, payments & the rest of your stack',
  'A say in the roadmap',
  'Dedicated hosting, upgrades & backups',
  'Dedicated support from the people who build Flotilla',
] as const;
---

<BaseLayout
  title="Pricing"
  description="Flotilla pricing — start a community for free, grow with hosted plans from $5/mo, put Flotilla under your own name from $300/mo, or get a platform built around your organization from $6,000/mo."
>
  <section class="relative py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary-soft">Pricing</p>
        <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl md:text-6xl">
          Start free. Grow when you're ready.
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-base text-text-muted sm:text-lg">
          Start a community in minutes, at no cost. Upgrade for hosting as you grow, or put
          Flotilla under your own name — no ads, no per-seat games, no lock-in.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {tiers.map((tier) => (
          <div
            class:list={[
              'relative flex h-full flex-col rounded-3xl border p-8',
              tier.featured
                ? 'border-primary/50 bg-primary/8 shadow-2xl'
                : 'border-border-soft bg-surface/50',
            ]}
          >
            {tier.featured && (
              <span class="absolute -top-3 left-8 rounded-pill bg-primary px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
                Most popular
              </span>
            )}
            <h2 class="text-2xl font-extrabold">{tier.name}</h2>
            <p class="mt-4 flex items-baseline gap-1.5">
              {tier.priceLabel && <span class="text-sm text-text-dim">{tier.priceLabel}</span>}
              <span class="text-4xl font-extrabold">{tier.price}</span>
              {tier.priceSuffix && <span class="text-sm text-text-dim">{tier.priceSuffix}</span>}
            </p>
            <p class="mt-3 text-sm text-text-muted">{tier.tagline}</p>

            <ul class="mt-6 space-y-3 text-sm">
              {tier.features.map((f) => (
                <li class="flex items-start gap-3">
                  <Icon name="ph:check-circle" class="mt-0.5 h-5 w-5 flex-none text-primary-soft" aria-hidden="true" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-8">
              <Button href={tier.cta.href} variant={tier.cta.variant} class={tier.cta.class}>
                {tier.cta.label}
              </Button>
            </div>
          </div>
        ))}
      </div>

      <p class="mx-auto mt-10 max-w-xl text-center text-sm text-text-dim">
        Prefer to run it yourself? Flotilla is
        <a href={SELF_HOST_URL} class="text-primary-soft hover:underline">self-hostable</a> at no cost.
      </p>
    </div>
  </section>

  <!-- Platform: a different product, not a bigger plan -->
  <section class="relative border-t border-border-soft bg-surface-2/30 py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary-soft">For organizations</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl md:text-5xl">
          Need more than a plan?
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-base text-text-muted sm:text-lg">
          The plans above host a space inside Flotilla. Platform is an app and infrastructure
          built around one organization, with our team behind it.
        </p>
      </div>

      <div class="mt-12 grid gap-10 rounded-3xl border border-primary/30 bg-surface/60 p-8 md:grid-cols-5 md:p-12">
        <div class="md:col-span-2">
          <h3 class="text-2xl font-extrabold">Platform</h3>
          <p class="mt-4 flex items-baseline gap-1.5">
            <span class="text-sm text-text-dim">from</span>
            <span class="text-4xl font-extrabold">$6,000</span>
            <span class="text-sm text-text-dim">/mo</span>
          </p>
          <p class="mt-3 text-sm text-text-muted">
            For membership networks, associations and institutions whose community is too
            important to run on a generic app.
          </p>
          <div class="mt-8 flex flex-col gap-3">
            <Button href="/articles/platform-plan" variant="primary" class="w-full">See the Platform plan</Button>
            <Button href={DEMO_URL} variant="secondary" class="w-full">Book a call</Button>
          </div>
        </div>
        <ul class="grid gap-3 text-sm sm:grid-cols-2 md:col-span-3">
          {platformFeatures.map((f) => (
            <li class="flex items-start gap-3">
              <Icon name="ph:check-circle" class="mt-0.5 h-5 w-5 flex-none text-primary-soft" aria-hidden="true" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
