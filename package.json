    "@welshman/editor": "^0.9.9",
    "@welshman/feeds": "^0.9.9",
    "@welshman/lib": "^0.9.9",
    "@welshman/net": "^0.9.9",
    "@welshman/signer": "^0.9.9",
    "@welshman/store": "^0.9.9",
    "@welshman/util": "^0.9.9",
    "cheerio": "^1.2.0",
    "compressorjs-next": "^1.1.2",
    "dompurify": "^3.4.13",
    "dotenv": "^16.6.1",
    "emoji-picker-element": "^1.28.1",
    "emoji-picker-element-data": "^1.8.0",
    "fuse.js": "^7.1.0",
