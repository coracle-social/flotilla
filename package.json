{
  "name": "flotilla",
  "version": "1.9.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "./scripts/build.sh",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "node server.js",
    "release:android": "./scripts/build.sh && cap build android --androidreleasetype APK --signing-type apksigner",
    "bump": "node scripts/bump-version.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check src e2e playwright.config.ts && eslint src e2e",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "git diff head --name-only --diff-filter d | grep -E '(js|ts|svelte|css)$' | xargs -r prettier --write",
    "format:all": "prettier --write src",
    "prepare": "husky"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.23",
    "capacitor-set-version": "^2.2.0",
    "classnames": "^2.5.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "sharp": "^0.35.3",
    "svelte": "^5.55.9",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.2",
    "ws": "^8.18.3"
  },
  "type": "module",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capawesome/capacitor-android-dark-mode-support": "^8.0.0",
    "@capawesome/capacitor-badge": "^8.0.0",
    "@getalby/lightning-tools": "^6.1.0",
    "@getalby/sdk": "^5.1.2",
    "@hono/node-server": "^2.0.0",
    "@noble/curves": "^1.9.7",
    "@pomade/core": "^0.3.3",
    "@poppanator/sveltekit-svg": "^7.0.0",
    "@svelte-plugins/datepicker": "^1.0.11",
    "@sveltejs/adapter-static": "^3.0.10",
    "@tiptap/core": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
