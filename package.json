{
  "name": "flotilla",
  "version": "1.11.1",
  "author": {
    "name": "Jon Staab"
  },
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "./scripts/build/app.sh",
    "build:desktop": "bash scripts/desktop/build.sh",
    "dev:desktop": "node scripts/desktop/dev.mjs",
    "start:desktop": "npm --prefix electron start",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "node server.js",
    "release:check": "node scripts/release/local.mjs --check && node scripts/release/ci.mjs --check",
    "release:changelog": "node scripts/release/changelog.mjs",
    "release:local": "node scripts/release/local.mjs",
    "release:ci": "node scripts/release/ci.mjs",
    "bump": "node scripts/release/bump.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check src e2e packages fdroid playwright.config.ts capacitor.config.ts electron/*.ts electron/electron-builder.config.mjs scripts/desktop/*.mjs scripts/release && eslint src e2e packages fdroid capacitor.config.ts electron/*.ts electron/electron-builder.config.mjs scripts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:desktop": "playwright test --config e2e/desktop/playwright.config.ts",
    "test:desktop-storage": "node --test packages/desktop-secure-storage/test/*.test.mjs",
    "format": "git diff head --name-only --diff-filter d | grep -E '(js|ts|svelte|css)$' | xargs -r prettier --write",
    "format:all": "prettier --write src",
    "prepare": "husky",
    "package:desktop:linux": "node scripts/desktop/package.mjs linux",
    "package:desktop:windows": "node scripts/desktop/package.mjs windows",
    "package:desktop:macos": "node scripts/desktop/package.mjs macos"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.23",
    "capacitor-set-version": "^2.2.0",
    "classnames": "^2.5.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "sharp": "^0.35.3",
    "svelte": "^5.55.9",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.2",
    "ws": "^8.18.3"
  },
  "type": "module",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capawesome/capacitor-android-dark-mode-support": "^8.0.0",
    "@capawesome/capacitor-badge": "^8.0.0",
    "@capawesome/capacitor-electron": "0.1.1",
    "@flotilla/desktop-secure-storage": "file:packages/desktop-secure-storage",
    "@flotilla/desktop-window": "file:packages/desktop-window",
    "@getalby/lightning-tools": "^6.1.0",
    "@getalby/sdk": "^5.1.2",
    "@hono/node-server": "^2.0.0",
    "@noble/curves": "~2.0.1",
    "@noble/hashes": "~2.0.1",
    "@pomade/core": "^0.3.3",
    "@poppanator/sveltekit-svg": "^7.0.0",
    "@svelte-plugins/datepicker": "^1.0.11",
    "@sveltejs/adapter-static": "^3.0.10",
    "@tiptap/core": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/suggestion": "^2.27.3",
    "@types/qrcode": "^1.5.6",
    "@types/throttle-debounce": "^5.0.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@welshman/app": "^0.11.0",
    "@welshman/content": "^0.11.0",
    "@welshman/domain": "^0.11.0",
    "@welshman/editor": "^0.11.0",
    "@welshman/feeds": "^0.11.0",
    "@welshman/lib": "^0.11.0",
    "@welshman/net": "^0.11.0",
    "@welshman/signer": "^0.11.0",
    "@welshman/store": "^0.11.0",
    "@welshman/util": "^0.11.0",
    "cheerio": "^1.2.0",
    "compressorjs-next": "^1.1.2",
    "dompurify": "^3.4.13",
    "dotenv": "^16.6.1",
    "emoji-picker-element": "^1.28.1",
    "emoji-picker-element-data": "^1.8.0",
    "focus-trap": "8.2.2",
    "fuse.js": "^7.1.0",
    "hono": "^4.12.23",
    "husky": "^9.1.7",
    "idb": "^8.0.3",
    "livekit-client": "^2.17.2",
    "marked": "^18.0.9",
    "nostr-signer-capacitor-plugin": "github:coracle-social/nostr-signer-capacitor-plugin#main",
    "nostr-tools": "^2.25.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "throttle-debounce": "^5.0.2",
    "tippy.js": "^6.3.7"
  },
  "packageManager": "pnpm@11.25.0"
}
